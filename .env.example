# Copy to .env (git-ignored) and fill in. Used by docker-compose only.
# POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
API_PORT=5080

# Only for `docker compose --profile api`. When running with `dotnet run`, use user-secrets instead.
# At least 32 random characters, e.g. PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SIGNING_KEY=
ADMIN_EMAIL=admin@bookstore.dz
ADMIN_PASSWORD=

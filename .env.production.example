# Copy to .env.production (git-ignored) for docker-compose.prod.yml, or enter the same
# variables in your hosting platform. Every line below except the ports goes to the API.

# --- Public URLs (no trailing slash) ---
SITE_URL=https://bookstore.example.dz
Cors__AllowedOrigins__0=https://bookstore.example.dz
Checkout__FrontendBaseUrl=https://bookstore.example.dz

# --- Supabase PostgreSQL: Project Settings -> Database -> Connection string -> "Session pooler" ---
# IPv4, port 5432 (NOT 6543 = transaction pooler, which the API refuses). TLS is enforced automatically.
ConnectionStrings__Default=Host=aws-0-eu-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD
# Npgsql pool per API instance; keep instances x this below the pooler's limit (free plan: ~15).
Database__MaxPoolSize=10
# Insert the ~30 demo books when the books table is empty (only during `migrate`).
Database__SeedDemoData=false

# --- Supabase Storage: Project Settings -> API (service_role stays server-side, never in the frontend) ---
Storage__Provider=Supabase
Storage__SupabaseUrl=https://YOUR_PROJECT_REF.supabase.co
Storage__SupabaseServiceKey=
Storage__SupabaseBucket=book-covers

# --- Auth ---
# 32+ random characters. PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
Jwt__SigningKey=
# The admin account `migrate` creates if missing (password: 8+ chars with upper, lower and a digit).
Seed__Admin__Email=admin@bookstore.example.dz
Seed__Admin__Password=

# --- Chargily Pay V2 (dashboard -> Developers corner) ---
# test mode needs test_sk_..., live mode needs live_sk_...
Chargily__Mode=test
Chargily__SecretKey=
Chargily__WebhookUrl=https://api.bookstore.example.dz/api/v1/payments/webhooks/chargily

# --- Host ports (read by docker compose, not the API) ---
API_PORT=8080
WEB_PORT=3000
